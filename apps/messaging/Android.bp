android_app {
    name: "AiosMessaging",
    manifest: "AndroidManifest.xml",
    srcs: [
        "src/**/*.kt",
        "platform/src/**/*.kt",
        ":framework-mms-shared-srcs",
    ],
    resource_dirs: ["res"],
    static_libs: [
        "aios_context_api",
        "aios_media_context_api",
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.core_core-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "kotlinx-coroutines-android",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    sdk_version: "system_current",
    min_sdk_version: "35",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    optimize: {
        enabled: true,
        shrink: true,
        shrink_resources: true,
    },
}

java_test_host {
    name: "aios_messaging_host_tests",
    srcs: [
        "src/com/aios/messaging/context/MessageContextPolicy.kt",
        "src/com/aios/messaging/context/MessagingServiceRebindPolicy.kt",
        "src/com/aios/messaging/context/LatestOperationQueue.kt",
        "src/com/aios/messaging/model/MessagePolicy.kt",
        "src/com/aios/messaging/model/SubscriptionSelectionPolicy.kt",
        "src/com/aios/messaging/mms/MmsOperationPolicy.kt",
        "tests/src/**/*.kt",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
