package {
    default_applicable_licenses: ["AIOS_Apache_2_0"],
}

license {
    name: "AIOS_Apache_2_0",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

prebuilt_etc {
    name: "aios_product_policy",
    src: "config/product_policy.json",
    filename: "product_policy.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_model_catalog",
    src: "config/model_catalog.json",
    filename: "model_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_model_admission",
    src: "config/model_admission.json",
    filename: "model_admission.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_runtime_catalog",
    src: "config/runtime_catalog.json",
    filename: "runtime_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_authorized_clients",
    src: "config/authorized_clients.json",
    filename: "authorized_clients.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-aios",
    src: "permissions/privapp-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "default-permissions-aios",
    src: "permissions/default-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    product_specific: true,
}

// Android 17 compares the legacy PRODUCT_PACKAGES file list with the
// dependencies of the selected Soong-defined system image.  Keep an AIOS-owned
// image wrapper instead of weakening that check or permanently editing AOSP's
// android_gsi module.  android_gsi_defaults remains owned and updated by AOSP;
// this defaults module is only the additive AIOS package surface.
android_filesystem_defaults {
    name: "aios_gsi_system_image_defaults",
    defaults: ["android_gsi_defaults"],
    visibility: ["//visibility:public"],
    deps: [
        "AiosCallIntelligence",
        "AiosContextIntelligence",
        "AiosFrameworkDefaultsOverlay",
        "AiosMediaIntelligence",
        "AiosMessaging",
        "AiosModelBroker",
        "AiosPhone",
        "aios_authorized_clients",
        "aios_model_admission",
        "aios_model_catalog",
        "aios_product_policy",
        "aios_runtime_catalog",
        "default-permissions-aios",
        "privapp-permissions-aios",

        // Match the compliance-GSI dependency carried by android_gsi.
        "system_ext_userdebug_plat_sepolicy.cil",
    ] + select(product_variable("debuggable"), {
        true: [
            "AiosModelBenchmark",
            "AiosModelBenchmarkTests",
        ],
        default: [],
    }) + select(soong_config_variable("gsi", "import_usb_debugging_test_app"), {
        true: ["UsbDisableDebugger"],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_litert_lm"), {
        true: [
            "AiosRuntimeProvider_litert_lm",
            "aios_runtime_artifacts_litert_lm",
        ],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_sherpa_onnx_tts"), {
        true: [
            "AiosRuntimeProvider_sherpa_onnx_tts",
            "aios_runtime_artifacts_sherpa_onnx_tts",
        ],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_whisper_cpp"), {
        true: [
            "AiosRuntimeProvider_whisper_cpp",
            "aios_runtime_artifacts_whisper_cpp",
        ],
        default: [],
    }),
    enabled: select(soong_config_variable(
        "ANDROID",
        "PRODUCT_INSTALL_DEBUG_POLICY_TO_SYSTEM_EXT",
    ), {
        "true": true,
        default: false,
    }),
}

// Model-free GSI used when no locally licensed generated model pack exists.
android_system_image {
    name: "aios_gsi_system_image",
    defaults: ["aios_gsi_system_image_defaults"],
}
