package {
    default_applicable_licenses: ["AIOS_Apache_2_0"],
}

license {
    name: "AIOS_Apache_2_0",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

// The GSI system-image wrapper can depend on this stable config module while
// its `required` edges carry the exact, locally generated AIOS package closure
// into Soong's transitive packaging specs. `required` is intentionally a
// non-configurable list property, so Android 17 supports list substitution.
soong_config_module_type {
    name: "aios_gsi_payload_anchor_type",
    module_type: "prebuilt_etc",
    config_namespace: "aios",
    list_variables: ["gsi_system_modules"],
    properties: ["required"],
}

aios_gsi_payload_anchor_type {
    name: "aios_product_policy",
    src: "config/product_policy.json",
    filename: "product_policy.json",
    sub_dir: "aios",
    product_specific: true,
    soong_config_variables: {
        gsi_system_modules: {
            required: ["%s"],
        },
    },
}

prebuilt_etc {
    name: "aios_model_catalog",
    src: "config/model_catalog.json",
    filename: "model_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_model_admission",
    src: "config/model_admission.json",
    filename: "model_admission.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_runtime_catalog",
    src: "config/runtime_catalog.json",
    filename: "runtime_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_authorized_clients",
    src: "config/authorized_clients.json",
    filename: "authorized_clients.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-aios",
    src: "permissions/privapp-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "default-permissions-aios",
    src: "permissions/default-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    product_specific: true,
}
