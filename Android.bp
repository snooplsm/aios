package {
    default_applicable_licenses: ["AIOS_Apache_2_0"],
}

license {
    name: "AIOS_Apache_2_0",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

// The GSI system-image wrapper depends on this stable config module. Its
// required edges carry AIOS into Soong's transitive packaging specs. Optional
// generated payloads use stable anchors selected only when their verified
// local pack exists; model membership stays generator-owned and unrestricted.
prebuilt_etc {
    name: "aios_product_policy",
    src: "config/product_policy.json",
    filename: "product_policy.json",
    sub_dir: "aios",
    product_specific: true,
    required: [
        "AiosCallIntelligence",
        "AiosContextIntelligence",
        "AiosFrameworkDefaultsOverlay",
        "AiosMediaIntelligence",
        "AiosMessaging",
        "AiosModelBroker",
        "AiosPhone",
        "aios_authorized_clients",
        "aios_model_admission",
        "aios_model_catalog",
        "aios_runtime_catalog",
        "default-permissions-aios",
        "privapp-permissions-aios",
    ] + select(product_variable("debuggable"), {
        true: ["AiosModelBenchmark"],
        default: [],
    }) + select(soong_config_variable("aios", "model_pack"), {
        true: ["aios_model_pack_anchor"],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_litert_lm"), {
        true: [
            "AiosRuntimeProvider_litert_lm",
            "aios_runtime_artifacts_litert_lm",
        ],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_sherpa_onnx_tts"), {
        true: [
            "AiosRuntimeProvider_sherpa_onnx_tts",
            "aios_runtime_artifacts_sherpa_onnx_tts",
        ],
        default: [],
    }) + select(soong_config_variable("aios", "runtime_whisper_cpp"), {
        true: [
            "AiosRuntimeProvider_whisper_cpp",
            "aios_runtime_artifacts_whisper_cpp",
        ],
        default: [],
    }),
}

prebuilt_etc {
    name: "aios_model_catalog",
    src: "config/model_catalog.json",
    filename: "model_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_model_admission",
    src: "config/model_admission.json",
    filename: "model_admission.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_runtime_catalog",
    src: "config/runtime_catalog.json",
    filename: "runtime_catalog.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "aios_authorized_clients",
    src: "config/authorized_clients.json",
    filename: "authorized_clients.json",
    sub_dir: "aios",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-aios",
    src: "permissions/privapp-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "default-permissions-aios",
    src: "permissions/default-permissions-aios.xml",
    filename_from_src: true,
    sub_dir: "default-permissions",
    product_specific: true,
}
