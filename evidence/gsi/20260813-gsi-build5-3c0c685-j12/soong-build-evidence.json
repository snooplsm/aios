      "file": "0002-framework-mms-aios-visibility.patch",
      "id": "framework-mms-aios-visibility",
      "owner": "messaging-platform",
      "paths": [
        "telephony/common/Android.bp"
      ],
      "project": "frameworks/base",
      "reason": "Allow the platform-signed AIOS Messaging app to statically link AOSP's maintained MMS codec and Telephony provider persister without copying protocol sources into vendor code, using Soong's required platform-to-vendor subtree visibility boundary.",
      "rebase_notes": "Re-export from the tracked frameworks/base commit, keep the change to the single telephony/common/Android.bp visibility entry using //vendor:__subpackages__, and rebuild AiosMessaging with Soong.",
      "removal_condition": "Remove when framework-mms-shared-srcs is public to product modules or AOSP provides an equivalent supported MMS codec and provider library.",
      "sha256": "d23751af96b0a0d24bc6b2b1cf6c5a237b3959b725d3941cbbfe7d2e75247dfe",
      "tests": [
        "tests/test_patch_series.py",
