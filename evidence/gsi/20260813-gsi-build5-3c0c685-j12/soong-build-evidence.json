    },
    {
      "base_revision": "5ce6f787337d0223710bf7d4a16dbe6d2a35f777",
      "file": "0003-build-make-configurable-gsi-size.patch",
      "id": "build-make-configurable-gsi-size",
      "owner": "gsi-platform",
      "paths": [
        "target/board/BoardConfigGsiCommon.mk",
        "target/product/gsi/Android.bp"
      ],
      "project": "build/make",
      "reason": "Preserve AOSP's compliance-GSI defaults while allowing an additive product to size its model-inclusive build container, declare its package closure to Android 17's Soong system-image check, and align that image with the board's chained GSI AVB key.",
      "rebase_notes": "Re-export from the tracked build/make base, preserve the two conditional size defaults and adjacent android_gsi_defaults wrapper, verify the default GSI remains 3 GiB, verify AIOS resolves its generated payload and 6 GiB group, then require chained AVB verification of vbmeta plus system.",
      "removal_condition": "Remove the sizing hunk when AOSP exposes a product-supported GSI sizing mechanism; remove the filesystem wrapper when additive products can extend android_gsi through a public Soong interface.",
      "sha256": "52fd3325d6d467b8248189520216ebbe0ba807fb01c4273579c031856fc67fe2",
      "tests": [
        "scripts/build-aosp-lane.sh",
        "tests/test_patch_series.py",
        "tests/test_validate_config.py"
      ]
    }
