java_library {
    name: "aios_call_api",
    srcs: ["aidl/**/*.aidl"],
    aidl: {
        include_dirs: ["vendor/aios/services/callintelligence/aidl"],
    },
    sdk_version: "system_current",
    min_sdk_version: "35",
    installable: false,
}

android_app {
    name: "AiosCallIntelligence",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    static_libs: [
        "aios_call_api",
        "aios_context_api",
        "aios_model_api",
    ],
    resource_dirs: [],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    product_specific: true,
    optimize: {
        enabled: true,
    },
}

java_test_host {
    name: "aios_callintelligence_host_tests",
    srcs: [
        "src/com/aios/callintelligence/AnswerDelayPolicy.java",
        "src/com/aios/callintelligence/AutomaticAnswerGate.java",
        "src/com/aios/callintelligence/AssistantHandlingTracker.java",
        "src/com/aios/callintelligence/AssistantTurnQueue.java",
        "src/com/aios/callintelligence/CallContextAccumulator.java",
        "src/com/aios/callintelligence/IncrementalCallerTranscript.java",
        "src/com/aios/callintelligence/TranscriptRevisionGate.java",
        "src/com/aios/callintelligence/CallArtifactRetention.java",
        "src/com/aios/callintelligence/CallRequestIdentityTracker.java",
        "src/com/aios/callintelligence/Pcm16MonoToStereo48k.java",
        "src/com/aios/callintelligence/PriorContextFormatter.java",
        "src/com/aios/callintelligence/RequiredCaptureGate.java",
        "src/com/aios/callintelligence/ReceptionistReplyPolicy.java",
        "src/com/aios/callintelligence/RiskAssessmentTracker.java",
        "src/com/aios/callintelligence/SpamRiskEngine.java",
        "src/com/aios/callintelligence/TelecomCallPresenceTracker.java",
        "tests/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_suites: ["general-tests"],
}
