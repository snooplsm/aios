<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aios.mediaintelligence">

    <permission
        android:name="com.aios.permission.ASSOCIATE_MEDIA_CONTEXT"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />
    <uses-permission android:name="com.aios.permission.USE_MODEL_BROKER" />
    <uses-permission android:name="com.aios.permission.USE_COMMUNICATION_CONTEXT" />

    <application
        android:allowBackup="false"
        android:directBootAware="false"
        android:hasCode="true"
        android:label="AIOS Media Intelligence"
        android:persistent="true">
        <activity
            android:name=".VideoEnhancedCopyActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Create AI-enhanced copy"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.Alert">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/mp4" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaObserverService"
            android:exported="false" />

        <service
            android:name=".VideoEnhancedCopyService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".MediaContextAssociationService"
            android:exported="true"
            android:permission="com.aios.permission.ASSOCIATE_MEDIA_CONTEXT">
            <intent-filter>
                <action android:name="com.aios.media.MEDIA_CONTEXT_ASSOCIATION_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".MediaInferenceJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".MediaBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
