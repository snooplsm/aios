java_library {
    name: "aios_model_api",
    srcs: ["aidl/**/*.aidl"],
    aidl: {
        include_dirs: ["vendor/aios/services/modelbroker/aidl"],
    },
    sdk_version: "system_current",
    min_sdk_version: "35",
    installable: false,
}

android_app {
    name: "AiosModelBroker",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    static_libs: [
        "aios_model_api",
        "aios_runtime_common",
        "aios_runtime_api",
    ],
    resource_dirs: [],
    sdk_version: "system_current",
    min_sdk_version: "35",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    optimize: {
        enabled: true,
    },
}

java_test_host {
    name: "aios_modelbroker_host_tests",
    srcs: [
        "src/com/aios/modelbroker/CallActivityLeaseTracker.java",
        "src/com/aios/modelbroker/BuildFingerprintPolicy.java",
        "src/com/aios/modelbroker/CatalogTierPlanner.java",
        "src/com/aios/modelbroker/EmbeddingRequestPolicy.java",
        "src/com/aios/modelbroker/EmbeddingResultPolicy.java",
        "src/com/aios/modelbroker/PolicyFileReader.java",
        "src/com/aios/modelbroker/RuntimeActivationState.java",
        "src/com/aios/modelbroker/RuntimeCandidatePolicy.java",
        "src/com/aios/modelbroker/RuntimePressurePolicy.java",
        "src/com/aios/modelbroker/RuntimeRebindPolicy.java",
        "src/com/aios/modelbroker/SessionCapacityPolicy.java",
        "src/com/aios/modelbroker/SessionArbiter.java",
        "src/com/aios/modelbroker/SessionChunkPolicy.java",
        "src/com/aios/modelbroker/SessionDeadlinePolicy.java",
        "src/com/aios/modelbroker/SessionDeadlineQueue.java",
        "src/com/aios/modelbroker/WorkClass.java",
        "src/com/aios/modelbroker/VerifiedArtifact.java",
        "tests/src/**/*.java",
    ],
    static_libs: [
        "aios_runtime_common",
        "junit",
    ],
    test_suites: ["general-tests"],
}
