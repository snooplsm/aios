<?xml version="1.0" encoding="utf-8"?>
<exceptions>
    <exception package="com.aios.callintelligence">
        <permission
            name="android.permission.RECORD_AUDIO"
            fixed="true" />
    </exception>

    <!-- Media Intelligence is a core, platform-signed component. Media reads
         are fixed; mutation still goes through MediaStore policy. Its export
         notification is visible because every export is owner-initiated. -->
    <exception package="com.aios.mediaintelligence">
        <permission
            name="android.permission.READ_MEDIA_IMAGES"
            fixed="true" />
        <permission
            name="android.permission.READ_MEDIA_VIDEO"
            fixed="true" />
        <permission
            name="android.permission.READ_PHONE_STATE"
            fixed="true" />
        <permission
            name="android.permission.POST_NOTIFICATIONS"
            fixed="true" />
    </exception>

    <!-- Contact membership is resolved centrally into opaque per-install keys.
         Raw numbers and contact lookup keys are never stored in the RAG index. -->
    <exception package="com.aios.contextintelligence">
        <permission
            name="android.permission.READ_CONTACTS"
            fixed="true" />
    </exception>

    <!-- AIOS Messaging needs subscription IDs and carrier labels to route SMS
         and MMS through the owner's selected SIM. The grant is intentionally
         revocable; sideloaded builds and revoked grants use the in-app fallback. -->
    <exception package="com.aios.messaging">
        <permission
            name="android.permission.READ_PHONE_STATE"
            fixed="false" />
    </exception>

</exceptions>
